{
  // Edge cache for Navi's PC Cafe catalog reads — see src/index.js
  "name": "natpc-cache",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "api.navipcshop.com", "custom_domain": true }
  ],
  // Per-IP edge rate limits for the two fronted write routes (src/index.js
  // FRONTED). Cloudflare's limiter only does 10s/60s windows; these stop
  // bursts — the per-actor open-hold caps live in the DB. namespace_id is an
  // account-unique integer per limiter.
  "unsafe": {
    "bindings": [
      { "name": "EXPRESS_RL", "type": "ratelimit", "namespace_id": "1101", "simple": { "limit": 6,  "period": 60 } },
      { "name": "CODE_RL",    "type": "ratelimit", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }
    ]
  },
  "vars": {
    // The publishable (anon) key — already public in the storefront page source
    "SUPABASE_URL": "https://rpmrmakidwzoxkpehrtp.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_Ms6_ZprtwxK6nFA9yQmjsg_qqBxJlE7"
  }
}
